#!/data/data/com.termux/files/usr/bin/bash

# DAP - Dess Archive Protect
# v3.2 - DESS-STATION OFFICIAL TOOL

set -e

# 1. Sequência de Inicialização
echo -e "\e[1;34m[*] Checking if all functions are correct...\e[0m"

# 2. Teste de Fogo (Criptografia Silenciosa)
# Criamos um arquivo de teste na home para validar o motor
TEST_FILE="$HOME/.dap_test"
TEST_OUT="$HOME/.dap_test.dess"
echo "dess-station-validation" > "$TEST_FILE"

# Tentativa de execução real
# Usamos 'openssl' com um pipe de erro para ver se o binário realmente responde
if ! openssl enc -aes-256-cbc -salt -pbkdf2 -pass pass:123 -in "$TEST_FILE" -out "$TEST_OUT" &>/dev/null; then
    
    # Se falhou, tenta o reparo silencioso
    echo -e "\e[1;33m[*] Installing remaining functions...\e[0m"
    pkg install openssl -y &>/dev/null
    
    # Segundo teste após a tentativa de reparo
    if ! openssl enc -aes-256-cbc -salt -pbkdf2 -pass pass:123 -in "$TEST_FILE" -out "$TEST_OUT" &>/dev/null; then
        rm -f "$TEST_FILE" "$TEST_OUT" # Limpeza
        echo -e "\n\e[1;31m[!] CRITICAL ERROR: DESS-STATION functions are incomplete.\e[0m"
        echo "--------------------------------------------------"
        echo "The system could not auto-repair. Please run:"
        echo -e "\e[1;32m      dap-error-info\e[0m"
        echo "--------------------------------------------------"
        exit 1
    fi
fi

# Se chegou aqui, as funções estão realmente ativas
rm -f "$TEST_FILE" "$TEST_OUT"
echo -e "\e[1;32m[✓] All functions are now active.\e[0m"
sleep 1

show_help() {
    clear
    echo -e "\e[1;36m██████   █████  ██████ "
    echo -e "██   ██ ██   ██ ██   ██"
    echo -e "██   ██ ███████ ██████ "
    echo -e "██   ██ ██   ██ ██     "
    echo -e "██████  ██   ██ ██           DESS ARCHIVE PROTECT\e[0m"
    echo "--------------------------------------------------"
    echo -e "\e[1;33m       >>> ULTIMATE HELP & DOCUMENTATION <<<\e[0m"
    echo "--------------------------------------------------"
    echo -e "\e[1;32m1. ENCRYPT (PROTECT):\e[0m"
    echo "   Command: dap --encrypt <path>"
    echo ""
    echo -e "\e[1;32m2. DECRYPT (RESTORE):\e[0m"
    echo "   Command: dap --decrypt <path.dess>"
    echo "--------------------------------------------------"
    echo "v3.2 - DESS-STATION OFFICIAL TOOL"
}

if [[ -z "$1" || "$1" == "--help" ]]; then 
    show_help
    exit 0
fi

# Lógica de Produção
ACTION="$1"
TARGET="${2%/}"
OUT=$([[ -d "$TARGET" ]] && echo "${TARGET}/protected.dess" || echo "${TARGET}.dess")

if [[ "$ACTION" == "--encrypt" ]]; then
    echo -e "\e[1;34m[*] Protecting: $TARGET\e[0m"
    if [[ -d "$TARGET" ]]; then
        tar -cf - "$TARGET" 2>/dev/null | openssl enc -aes-256-cbc -salt -pbkdf2 -out "$OUT"
    else
        openssl enc -aes-256-cbc -salt -pbkdf2 -in "$TARGET" -out "$OUT"
    fi
    echo -e "\e[1;32m[✓] Saved to: $OUT\e[0m"
elif [[ "$ACTION" == "--decrypt" ]]; then
    echo -e "\e[1;34m[*] Restoring...\e[0m"
    openssl enc -aes-256-cbc -d -salt -pbkdf2 -in "$TARGET" -out "${TARGET%.dess}"
    echo -e "\e[1;32m[✓] Decrypted.\e[0m"
fi
